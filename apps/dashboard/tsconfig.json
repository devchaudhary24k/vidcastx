{
  "extends": "@vidcastx/typescript-config/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@dashboard/*": ["./src/*"],
      "@vidcastx/ui/*": ["../../packages/ui/src/*"],
      "@server/*": ["../api/src/*"],
      "@transcoder/*": ["../../workers/transcoder/src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": ["next-env.d.ts", "next.config.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
