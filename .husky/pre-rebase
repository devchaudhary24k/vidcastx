# ─── Pre-rebase: block rebase on shared branches ─────
# Args: $1 = upstream, $2 = branch being rebased (empty if current HEAD).
# Rebasing main/dev rewrites shared history — forbidden per .claude/rules/git-workflow.md.

branch=${2:-$(git symbolic-ref --short HEAD 2>/dev/null)}

case "$branch" in
  main|dev|master|develop)
    echo ""
    echo "✖ Refusing to rebase '$branch' — it's a shared branch."
    echo "  Rewriting shared history breaks other collaborators."
    echo "  Create a topic branch and rebase that instead."
    echo ""
    exit 1
    ;;
esac

exit 0
