{
  "name": "@vidcastx/queue",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "check-types": "tsc --noEmit --emitDeclarationOnly false",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "with-env": "dotenv -e ../../.env --"
  },
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./shutdown": "./src/shutdown.ts"
  },
  "prettier": "@vidcastx/prettier",
  "devDependencies": {
    "@types/node": "^25.3.3",
    "@vidcastx/eslint-config": "workspace:*",
    "@vidcastx/prettier": "workspace:*",
    "@vidcastx/typescript-config": "workspace:*",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.4"
  },
  "dependencies": {
    "@vidcastx/redis": "workspace:^",
    "bullmq": "^5.70.1"
  }
}
