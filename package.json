{
  "name": "vidcastx",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:app": "turbo watch dev -F app...",
    "dev:api": "turbo watch dev -F api...",
    "start": "turbo start",
    "lint": "turbo run lint --continue -- --cache --cache-location .cache/.eslintcache",
    "lint:fix": "turbo run lint --continue -- --fix --cache --cache-location .cache/.eslintcache",
    "lint:ws": "pnpm dlx sherif@latest",
    "check-types": "turbo check-types",
    "format": "turbo run format --continue -- --cache --cache-location .cache/.prettiercache",
    "format:fix": "turbo run format --continue -- --write --cache --cache-location .cache/.prettiercache",
    "clean": "git clean -xdf node_modules .turbo",
    "clean:workspaces": "turbo run clean",
    "bump-deps": "npx npm-check-updates --deep -i",
    "bump-ui": "npx shadcn@canary add --all --overwrite -c packages/ui",
    "db:migrate": "turbo db:migrate",
    "db:generate": "turbo db:generate",
    "db:push": "turbo db:push",
    "db:studio": "turbo db:studio",
    "postinstall": "pnpm lint:ws",
    "prepare": "husky"
  },
  "devDependencies": {
    "@turbo/gen": "^2.8.13",
    "@vidcastx/eslint-config": "workspace:*",
    "@vidcastx/prettier": "workspace:*",
    "@vidcastx/typescript-config": "workspace:*",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "turbo": "^2.8.13",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20"
  },
  "prettier": "@vidcastx/prettier",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*",
    "workers/*"
  ],
  "overrides": {
    "@types/minimatch": "5.1.2"
  }
}
